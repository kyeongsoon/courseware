rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isTeacher() {
      return signedIn() && me().role == 'teacher';
    }
    // 로그인한 학생의 소속 반 (없으면 null)
    function myClassId() {
      return me().get('classId', null);
    }
    function isStr(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    // 로그인한 학생이 이 반 소속인지
    function inClass(classId) {
      return signedIn() && myClassId() != null && myClassId() == classId;
    }
    // 학생이 자기 이름·학번을 사칭하지 못하게, 저장하는 이름이 자기 계정 정보와 같은지
    function isMyName(d) {
      return d.name == me().get('displayName', '') && d.studentId == me().get('studentId', '');
    }

    match /users/{uid} {
      // 본인 문서 또는 교사만 읽기
      allow get: if signedIn() && (request.auth.uid == uid || isTeacher());
      allow list: if isTeacher();

      // 본인 문서 생성: 역할은 반드시 student
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.uid == uid
        && request.resource.data.get('classId', null) == null;

      // 본인 수정: 역할·소속 반·계정 정보는 변경 불가 (권한 상승·반 이동 방지)
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'uid', 'createdAt', 'classId', 'loginId', 'createdBy', 'deleted', 'deletedAt']);

      // 교사가 학생 계정 문서를 대신 생성 (역할은 student 만 가능)
      allow create: if isTeacher() && request.resource.data.role == 'student';

      // 교사는 학생 정보 수정 가능, 삭제는 교사만
      allow update, delete: if isTeacher();
    }

    // 반(학급): 로그인한 누구나 읽기(학생이 자기 반 이름을 봄), 만들기·수정·삭제는 교사만
    match /classes/{classId} {
      allow read: if signedIn();
      allow create: if isTeacher()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30;
      allow update: if isTeacher()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30;
      allow delete: if isTeacher();
    }

    // 단원: 제목은 학생도 봐야 하므로 로그인한 누구나 읽기, 쓰기는 교사만
    match /units/{unitId} {
      allow read: if signedIn();
      allow create, update: if isTeacher()
        && isStr(request.resource.data.title, 1, 60)
        && request.resource.data.order is number;
      allow delete: if isTeacher();
    }

    // 차시: 교사는 전부, 학생은 자기 반에 공개된 차시만 읽기
    match /lessons/{lessonId} {
      function validLesson() {
        let d = request.resource.data;
        return isStr(d.unitId, 1, 100)
          && isStr(d.title, 1, 100)
          && isStr(d.summary, 0, 300)
          && isStr(d.body, 0, 20000)
          && isStr(d.videoUrl, 0, 500)
          && d.links is list && d.links.size() <= 20
          && d.openClassIds is list && d.openClassIds.size() <= 100
          && d.order is number
          && d.get('slideCount', 0) is int && d.get('slideCount', 0) >= 0 && d.get('slideCount', 0) <= 150
          && isStr(d.get('slidesName', ''), 0, 100)
          && isStr(d.get('slidesVersion', ''), 0, 40);
      }
      // 실시간 수업 중이면, 공개하지 않은 차시라도 지금 띄운 차시는 그 반 학생이 볼 수 있음
      function isLiveLessonForMyClass() {
        let livePath = /databases/$(database)/documents/live/$(myClassId());
        return exists(livePath)
          && get(livePath).data.active == true
          && get(livePath).data.lessonId == lessonId;
      }
      allow read: if isTeacher()
        || (signedIn() && myClassId() != null
            && (myClassId() in resource.data.openClassIds || isLiveLessonForMyClass()));
      allow create, update: if isTeacher() && validLesson();
      allow delete: if isTeacher();

      // 슬라이드 그림: 차시를 볼 수 있는 사람만 보기, 교사만 올리기
      match /slides/{slideId} {
        function lessonData() {
          return get(/databases/$(database)/documents/lessons/$(lessonId)).data;
        }
        allow read: if isTeacher()
          || (signedIn() && myClassId() != null
              && (myClassId() in lessonData().openClassIds || isLiveLessonForMyClass()));
        allow create, update: if isTeacher()
          && request.resource.data.index is int
          && request.resource.data.image is string
          && request.resource.data.image.size() <= 1000000
          && request.resource.data.image.matches('^data:image/(webp|jpeg|png);base64,.*');
        allow delete: if isTeacher();
      }
    }

    // 실시간 수업: 반마다 문서 하나. 교사가 쓰고, 그 반 학생은 읽기만
    match /live/{classId} {
      function validLive() {
        let d = request.resource.data;
        return d.active is bool
          && d.follow is bool
          && d.videoMode in ['sync', 'teacher']
          && d.get('slide', 0) is int && d.get('slide', 0) >= 0
          && isStr(d.lessonId, 0, 100)
          && d.teacherUid == request.auth.uid;
      }
      allow read: if isTeacher() || (signedIn() && myClassId() == classId);
      allow create, update: if isTeacher() && validLive();
      allow delete: if isTeacher();

      // 접속·손들기·다 했어요: 학생은 자기 문서만, 자기 반 수업에만 씀
      match /members/{uid} {
        function validMember() {
          let d = request.resource.data;
          return d.keys().hasOnly(['name', 'studentId', 'lastSeen', 'hand', 'doneLessonId', 'focused', 'awayCount'])
            && isStr(d.name, 0, 50)
            && isStr(d.studentId, 0, 20)
            && d.lastSeen == request.time
            && d.hand is bool
            && isStr(d.doneLessonId, 0, 100)
            && d.get('focused', true) is bool
            && d.get('awayCount', 0) is int && d.get('awayCount', 0) >= 0;
        }
        allow read: if isTeacher() || (signedIn() && request.auth.uid == uid);
        allow create, update: if signedIn() && request.auth.uid == uid
          && myClassId() == classId && validMember();
        // 교사: 손 내리기, 새 수업 시작 때 지난 기록 지우기
        allow update, delete: if isTeacher();
      }
    }

    // ───── 학급운영: 소통 ─────

    // 알림장(공지): 교사가 쓰고, 그 반 학생이 읽음
    match /notices/{noticeId} {
      function validNotice() {
        let d = request.resource.data;
        return isStr(d.classId, 1, 100)
          && isStr(d.title, 1, 100)
          && isStr(d.body, 0, 5000)
          && d.pinned is bool
          && d.teacherUid == request.auth.uid;
      }
      allow read: if isTeacher() || inClass(resource.data.classId);
      allow create, update: if isTeacher() && validNotice();
      allow delete: if isTeacher();

      // 읽음 확인: 학생은 자기 것만 한 번 기록, 교사는 전부 봄
      match /reads/{uid} {
        allow read: if isTeacher() || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn() && request.auth.uid == uid
          && inClass(get(/databases/$(database)/documents/notices/$(noticeId)).data.classId)
          && request.resource.data.keys().hasOnly(['name', 'studentId', 'readAt'])
          && isMyName(request.resource.data)
          && request.resource.data.readAt == request.time;
        allow delete: if isTeacher();
      }
    }

    // 설문·투표
    match /polls/{pollId} {
      function validPoll() {
        let d = request.resource.data;
        return isStr(d.classId, 1, 100)
          && isStr(d.title, 1, 100)
          && isStr(d.description, 0, 1000)
          && d.options is list && d.options.size() >= 2 && d.options.size() <= 20
          && d.multiple is bool
          && d.anonymous is bool
          && d.closed is bool
          && d.teacherUid == request.auth.uid;
      }
      function pollData() {
        return get(/databases/$(database)/documents/polls/$(pollId)).data;
      }
      allow read: if isTeacher() || inClass(resource.data.classId);
      allow create, update: if isTeacher() && validPoll();
      allow delete: if isTeacher();

      // 응답: 학생은 자기 응답만, 마감 전까지 쓰고 고칠 수 있음. 익명 설문이면 이름을 저장하지 않음
      match /responses/{uid} {
        function validResponse() {
          let d = request.resource.data;
          let poll = pollData();
          return inClass(poll.classId)
            && poll.closed == false
            && d.choices is list
            && d.choices.size() >= 1
            && d.choices.size() <= poll.options.size()
            && (poll.multiple || d.choices.size() == 1)
            && d.choices.toSet().size() == d.choices.size()
            && d.answeredAt == request.time
            && ((poll.anonymous && d.keys().hasOnly(['choices', 'answeredAt']))
                || (!poll.anonymous && d.keys().hasOnly(['choices', 'answeredAt', 'name', 'studentId']) && isMyName(d)));
        }
        allow read: if isTeacher() || (signedIn() && request.auth.uid == uid);
        allow create, update: if signedIn() && request.auth.uid == uid && validResponse();
        allow delete: if isTeacher();
      }
    }

    // 상담 신청: 학생이 자기 이름으로 신청, 본인과 교사만 봄. 답변·상태는 교사만
    match /counsel/{counselId} {
      function validRequest() {
        let d = request.resource.data;
        return d.keys().hasOnly(['classId', 'studentUid', 'name', 'studentId', 'topic', 'message', 'preferredTime', 'status', 'reply', 'createdAt'])
          && inClass(d.classId)
          && d.studentUid == request.auth.uid
          && isMyName(d)
          && d.topic in ['학교생활', '친구관계', '진로·진학', '학습', '가정', '기타']
          && isStr(d.message, 1, 2000)
          && isStr(d.preferredTime, 0, 100)
          && d.status == 'new'
          && d.reply == ''
          && d.createdAt == request.time;
      }
      allow read: if isTeacher() || (signedIn() && resource.data.studentUid == request.auth.uid);
      allow create: if signedIn() && validRequest();
      // 교사: 상태와 답변만 바꿈
      allow update: if isTeacher()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reply', 'updatedAt'])
        && request.resource.data.status in ['new', 'scheduled', 'done']
        && isStr(request.resource.data.reply, 0, 2000);
      // 학생은 아직 확인 전인 자기 신청만 취소, 교사는 삭제 가능
      allow delete: if isTeacher()
        || (signedIn() && resource.data.studentUid == request.auth.uid && resource.data.status == 'new');
    }

    // ───── 학급운영: 생활 ─────

    // 한국 시각 기준 오늘 (예: 20261128) / 이번 달 (예: 202611)
    function kstNow() {
      return request.time + duration.value(9, 'h');
    }
    function todayKst() {
      return kstNow().year() * 10000 + kstNow().month() * 100 + kstNow().day();
    }
    function thisMonthKst() {
      return kstNow().year() * 100 + kstNow().month();
    }

    // 출결: 문서 하나 = 한 학생의 하루. 문서 이름은 '반_날짜_학생'
    match /attendance/{attendanceId} {
      function validByTeacher() {
        let d = request.resource.data;
        return isStr(d.classId, 1, 100)
          && isStr(d.uid, 1, 128)
          && d.date is int && d.month is int
          && attendanceId == d.classId + '_' + string(d.date) + '_' + d.uid
          && d.status in ['present', 'late', 'early', 'absent']
          && d.reason in ['', '질병', '미인정', '기타', '출석인정']
          && isStr(d.note, 0, 200)
          && d.by in ['self', 'teacher'];
      }
      // 교실 화면의 출석 코드가 맞는지: 지금 코드나 직전 코드, 만든 지 45초 안 (학생은 코드 문서를 못 읽음)
      function codeMatches(code, c) {
        return (c.code is string && c.code.size() == 6 && code == c.code
                  && c.issuedAt is timestamp && request.time < c.issuedAt + duration.value(45, 's'))
          || (c.prevCode is string && c.prevCode.size() == 6 && code == c.prevCode
                  && c.prevIssuedAt is timestamp && request.time < c.prevIssuedAt + duration.value(45, 's'));
      }
      function codeOk(d) {
        return get(/databases/$(database)/documents/classes/$(d.classId)).data.get('checkInOpen', false) == true
          || (d.get('code', '') is string && d.get('code', '').size() == 6
              && exists(/databases/$(database)/documents/checkinCodes/$(d.classId))
              && codeMatches(d.code, get(/databases/$(database)/documents/checkinCodes/$(d.classId)).data));
      }
      // 학생: 오늘, 자기 반, 자기 이름으로 '출석'만 처음 한 번 기록 (교사가 먼저 적어 둔 날은 못 덮어씀)
      // 교실 화면의 출석 코드(QR)가 있어야 함 (반 설정에서 '코드 없이 허용'을 켠 날은 빼고)
      function validCheckIn() {
        let d = request.resource.data;
        return d.keys().hasOnly(['classId', 'uid', 'date', 'month', 'name', 'studentId', 'status', 'reason', 'note', 'by', 'code', 'checkedAt'])
          && d.uid == request.auth.uid
          && inClass(d.classId)
          && d.date == todayKst()
          && d.month == thisMonthKst()
          && attendanceId == d.classId + '_' + string(d.date) + '_' + d.uid
          && isMyName(d)
          && d.status == 'present' && d.reason == '' && d.note == '' && d.by == 'self'
          && d.checkedAt == request.time
          && codeOk(d);
      }
      allow read: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if (isTeacher() && validByTeacher()) || (signedIn() && validCheckIn());
      allow update: if isTeacher() && validByTeacher();
      allow delete: if isTeacher();
    }

    // 출석 코드: 교사 화면만 읽고 씀 (학생 출석 기록의 코드 확인은 위 규칙에서 get 으로)
    match /checkinCodes/{classId} {
      allow read, write: if isTeacher();
    }

    // 자리표: 반마다 하나. 교사가 만들고, 공개하면 그 반 학생이 봄
    match /seating/{classId} {
      allow read: if isTeacher() || (inClass(classId) && resource.data.published == true);
      allow write: if isTeacher()
        && request.resource.data.rows is int && request.resource.data.rows >= 1 && request.resource.data.rows <= 12
        && request.resource.data.cols is int && request.resource.data.cols >= 1 && request.resource.data.cols <= 12
        && request.resource.data.cells is list
        && request.resource.data.cells.size() == request.resource.data.rows * request.resource.data.cols
        && request.resource.data.locked is list
        && request.resource.data.published is bool;
    }

    // ───── 교우관계 조사 ─────
    // 조사 회차: 교사가 만들고 그 반 학생이 읽음 (질문, 친구를 고를 반 명단)
    match /relSurveys/{surveyId} {
      allow read: if isTeacher() || inClass(resource.data.classId);
      allow create, update: if isTeacher()
        && isStr(request.resource.data.classId, 1, 100)
        && isStr(request.resource.data.title, 1, 40)
        && request.resource.data.questionIds is list
        && request.resource.data.questionIds.size() >= 1 && request.resource.data.questionIds.size() <= 3
        && request.resource.data.questionIds.hasOnly(['q1', 'q2', 'q3'])
        && request.resource.data.maxPicks is int && request.resource.data.maxPicks >= 1 && request.resource.data.maxPicks <= 5
        && request.resource.data.roster is list && request.resource.data.roster.size() <= 60
        && request.resource.data.open is bool;
      allow delete: if isTeacher();
    }
    // 응답: 학생은 진행 중인 자기 반 조사에 자기 응답만 쓰고 읽음. 남의 응답·결과는 교사만
    match /relResponses/{responseId} {
      function picksOk(a, q, max) {
        return !(q in a) || (a[q] is list && a[q].size() <= max && !(request.auth.uid in a[q]));
      }
      // 갈등 질문: 최대 2명, 자기 자신 안 됨, 내용 200자까지
      function conflictOk(c) {
        return c is map && c.keys().hasOnly(['uid', 'text']) && c.uid is string && c.uid != request.auth.uid
          && c.text is string && c.text.size() <= 200;
      }
      function conflictsOk(d, s) {
        return !('conflicts' in d)
          || (s.get('conflictQ', false) == true && d.conflicts is list && d.conflicts.size() <= 2
              && (d.conflicts.size() < 1 || conflictOk(d.conflicts[0]))
              && (d.conflicts.size() < 2 || conflictOk(d.conflicts[1])));
      }
      function validResponse() {
        let d = request.resource.data;
        let s = get(/databases/$(database)/documents/relSurveys/$(d.surveyId)).data;
        return d.keys().hasOnly(['surveyId', 'classId', 'uid', 'answers', 'conflicts', 'submittedAt'])
          && conflictsOk(d, s)
          && responseId == d.surveyId + '_' + request.auth.uid
          && d.uid == request.auth.uid
          && d.classId == s.classId && inClass(d.classId)
          && s.open == true
          && d.answers is map && d.answers.keys().hasOnly(s.questionIds)
          && picksOk(d.answers, 'q1', s.maxPicks) && picksOk(d.answers, 'q2', s.maxPicks) && picksOk(d.answers, 'q3', s.maxPicks)
          && d.submittedAt == request.time;
      }
      allow get: if isTeacher() || (signedIn() && responseId.split('_')[1] == request.auth.uid);
      allow list: if isTeacher();
      allow create, update: if signedIn() && !isTeacher() && validResponse();
      // 교사: 학생 계정을 지울 때 다른 학생 응답에서 그 학생을 빼기 위해 고칠 수 있음
      allow update: if isTeacher() && request.resource.data.surveyId == resource.data.surveyId && request.resource.data.uid == resource.data.uid;
      allow delete: if isTeacher();
    }
    // 교사 관찰 기록
    match /relNotes/{noteId} {
      allow read, write: if isTeacher();
    }

    // ───── 학급운영: 일정 ─────

    // 학급 달력 일정: 교사가 쓰고 그 반 학생이 봄
    match /events/{eventId} {
      function validEvent() {
        let d = request.resource.data;
        return isStr(d.classId, 1, 100)
          && isStr(d.title, 1, 100)
          && d.type in ['시험', '수행평가', '행사', '과제', '기타']
          && d.date is int && d.date >= 20000101 && d.date <= 21001231
          && d.endDate is int && d.endDate >= d.date && d.endDate <= 21001231
          && isStr(d.note, 0, 1000)
          && d.teacherUid == request.auth.uid;
      }
      allow read: if isTeacher() || inClass(resource.data.classId);
      allow create, update: if isTeacher() && validEvent();
      allow delete: if isTeacher();
    }

    // 시간표: 반마다 하나
    match /timetables/{classId} {
      allow read: if isTeacher() || inClass(classId);
      allow write: if isTeacher()
        && request.resource.data.days is int && request.resource.data.days >= 5 && request.resource.data.days <= 6
        && request.resource.data.periods is int && request.resource.data.periods >= 1 && request.resource.data.periods <= 10
        && request.resource.data.cells is list
        && request.resource.data.cells.size() == request.resource.data.days * request.resource.data.periods
        && request.resource.data.times is list
        && request.resource.data.times.size() == request.resource.data.periods;
    }

    // 학교 설정 (나이스 학교 코드·API 키): 교사만
    match /settings/{settingId} {
      allow read, write: if isTeacher();
    }

    // 그 외 컬렉션은 기본 차단 (기능 추가 시 규칙도 함께 추가)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
