# Firebase 콘솔 > 프로젝트 설정 > 내 앱(웹) 에서 값을 복사해 .env.local 로 저장하세요.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 교사가 만든 학생 계정의 아이디 뒤에 붙는 내부용 이메일 도메인 (실제 메일은 보내지 않음)
# 예: 아이디 30215 → 30215@student.invalid
VITE_STUDENT_EMAIL_DOMAIN=student.invalid

# 로컬 에뮬레이터로 테스트할 때만 true (npm run emulators 와 함께 사용)
VITE_USE_EMULATOR=false

# 학생 비밀번호 초기화 버튼 (Blaze 요금제로 바꾸고 Cloud Functions 를 배포한 뒤 true)
VITE_ENABLE_PASSWORD_RESET=false

# 수업·슬라이드·실시간 수업 기능 켜기/끄기 (true | false)
VITE_FEATURE_LESSONS=false
